# --- Logging ---
LOG_LEVEL=INFO

# --- LLM (primary — API key based, e.g. OpenAI / vLLM / DeepSeek) ---
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=your-llm-api-key
LLM_MODEL_PRIMARY=deepseek-ai/DeepSeek-V4-Flash
LLM_MODEL_CHEAP=qwen2.5:1.5b

# --- Ollama (fallback for LLM + embeddings) ---
OLLAMA_BASE_URL=http://ollama:11434/v1
OLLAMA_EMBED_MODEL=nomic-embed-text
EMBED_DIMENSION=768

# --- LLM client tuning ---
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=2048
REQUEST_TIMEOUT_S=60
MAX_RETRIES=3

# --- PostgreSQL (pgvector) ---
POSTGRES_URL=postgresql+asyncpg://user:password@host:5432/db
POSTGRES_DB=evraz_rag
POSTGRES_HOST=postgres
POSTGRES_PASSWORD=your-password
POSTGRES_USER=postgres
POSTGRES_PORT=5432