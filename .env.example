LOG_LEVEL=INFO 

LLM_BASE_URL=your-llm-base-url
LLM_API_KEY=your-llm-api-key
LLM_MODEL_PRIMARY=deepseek-ai/DeepSeek-V4-Flash
LLM_MODEL_CHEAP=qwen2.5:1.5b
OLLAMA_EMBED_MODEL=BAAI/bge-m3
EMBED_DIMENSION=1024
OLLAMA_BASE_URL=http://ollama:11434

POSTGRES_URL=postgresql+asyncpg://User:Pass@postgres:5432/postgres
POSTGRES_DB=postgres
POSTGRES_HOST=postgres
POSTGRES_PASSWORD=Pass
POSTGRES_USER=User
POSTGRES_PORT=5432

# Qdrant (векторное хранилище)
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=evraz_chunks
QDRANT_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
QDRANT_SPARSE_MODEL=Qdrant/bm25

# Реранкер (flashrank)
RERANKER_MODEL=ms-marco-MiniLM-L-12-v2
RERANKER_ENABLED=true
RERANKER_TOP_K=5

LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=2048
REQUEST_TIMEOUT_S=60
MAX_RETRIES=3
