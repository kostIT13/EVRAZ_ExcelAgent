LOG_LEVEL=INFO
DEBUG=false

LLM_BASE_URL=your-llm-base-url
LLM_API_KEY=your-llm-api-key
LLM_MODEL_PRIMARY=deepseek-ai/DeepSeek-V4-Flash
LLM_MODEL_CHEAP=qwen2.5:1.5b

POSTGRES_URL=postgresql+asyncpg://User:Pass@postgres:5432/postgres
POSTGRES_DB=postgres
POSTGRES_HOST=postgres
POSTGRES_PASSWORD=Pass
POSTGRES_USER=User
POSTGRES_PORT=5432

LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=2048
REQUEST_TIMEOUT_S=60
MAX_RETRIES=3

DB_STATEMENT_TIMEOUT_MS=30000

TRIGRAM_THRESHOLD=0.25

# Auth: API-ключ для /files/* и /ask/*. Пустой -> auth отключён (dev).
API_KEY=
RATE_LIMIT_ASK=30/minute
RATE_LIMIT_UPLOAD=10/minute

INGESTION_QUEUE_MODE=inproc

